{
  "name": "@gogum4/editor-react",
  "version": "0.7.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gogum4/js-editor.git",
    "directory": "packages/editor-react"
  },
  "type": "module",
  "description": "에디터의 React 화면 — 노드 뷰, 메뉴, 수식·각주 편집 창, 표 편집 막대, 컨텍스트. core의 확장에 주입해서 쓴다(docs/EDITOR-PACKAGE.md P5)",
  "sideEffects": false,
  "files": [
    "dist",
    "styles"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./styles/index.css"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./styles.css": "./styles/index.css"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-dts-imports.mjs dist"
  },
  "dependencies": {
    "@gogum4/editor-core": "workspace:*",
    "@gogum4/editor-schema": "workspace:*",
    "@tiptap/core": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "yjs": "^13.6.33",
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "mermaid": "^12.2.0"
  }
}
