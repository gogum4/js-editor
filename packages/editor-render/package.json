{
  "name": "@9um4/editor-render",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "읽기 전용 렌더링 — 본문 JSON/Markdown → React 요소·HTML. 서버 컴포넌트(Next.js App Router)에서 훅 없이 동작한다(docs/EDITOR-PACKAGE.md P4)",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@9um4/editor-markdown": "workspace:*",
    "@9um4/editor-schema": "workspace:*",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.10",
    "lowlight": "^3.3.0"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
