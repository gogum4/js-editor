{
  "name": "@9um4-utils/editor-render",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/9um4-utils/mine.git",
    "directory": "packages/editor-render"
  },
  "type": "module",
  "description": "읽기 전용 렌더링 — 본문 JSON/Markdown → React 요소·HTML. 서버 컴포넌트(Next.js App Router)에서 훅 없이 동작한다(docs/EDITOR-PACKAGE.md P4)",
  "sideEffects": false,
  "files": [
    "dist",
    "styles"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./styles/render.css",
    "./highlight.css": "./styles/highlight.css",
    "./katex.css": "./styles/katex.css",
    "./html": "./src/html.ts"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./styles.css": "./styles/render.css",
      "./highlight.css": "./styles/highlight.css",
      "./katex.css": "./styles/katex.css",
      "./html": {
        "types": "./dist/html.d.ts",
        "default": "./dist/html.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-dts-imports.mjs dist"
  },
  "dependencies": {
    "@9um4-utils/editor-markdown": "workspace:*",
    "@9um4-utils/editor-schema": "workspace:*",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.10",
    "lowlight": "^3.3.0"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "mermaid": "^12.2.0"
  },
  "peerDependenciesMeta": {
    "mermaid": {
      "optional": true
    }
  }
}
