{
  "name": "@9um4/editor-schema",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/9um4/editor.git",
    "directory": "packages/editor-schema"
  },
  "type": "module",
  "description": "에디터 스키마의 순수 규칙 — 노드·속성 정규화, 언어 이름 데이터. TipTap·DOM·앱 비의존(docs/EDITOR-PACKAGE.md)",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    "./*": "./src/*.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-dts-imports.mjs dist"
  }
}
