{
  "name": "@9um4/editor-core",
  "version": "0.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/9um4/editor.git",
    "directory": "packages/editor-core"
  },
  "type": "module",
  "description": "에디터 코어 — TipTap 확장, 포트·주입 접점 인터페이스, 화면 글 사전. React 화면은 @9um4/editor-react, 위키·저장·동기화는 없다(docs/EDITOR-PACKAGE.md)",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-dts-imports.mjs dist"
  },
  "dependencies": {
    "@9um4/editor-markdown": "workspace:*",
    "@9um4/editor-schema": "workspace:*",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-code-block": "^3.32.0",
    "@tiptap/extension-collaboration": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "@tiptap/y-tiptap": "^3.0.10",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.10",
    "lowlight": "^3.3.0",
    "mermaid": "^12.2.0",
    "yjs": "^13.6.33"
  }
}
