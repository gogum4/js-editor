{
  "name": "editor-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "9um4 에디터 패키지 묶음(@9um4/editor-*) — 작업 공간. 게시 대상은 packages/ 아래 패키지들이다.",
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:languages": "node scripts/gen-language-data.mjs",
    "check:deps": "node scripts/check-package-deps.mjs && node scripts/check-core-strings.mjs && node scripts/check-css-rules.mjs && node scripts/check-css-tokens.mjs",
    "check:dist": "pnpm build:packages && node scripts/check-pack.mjs && node scripts/check-types-consumer.mjs && node scripts/smoke-package-dist.mjs",
    "build:packages": "pnpm --filter @9um4/editor-schema --filter @9um4/editor-markdown --filter @9um4/editor-render --filter @9um4/editor-core --filter @9um4/editor-react build",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm check:deps && pnpm check:dist && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "happy-dom": "^21.0.4",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.5",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-code-block": "^3.32.0",
    "@tiptap/extension-collaboration": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "@tiptap/y-tiptap": "^3.0.10",
    "fractional-indexing": "^4.0.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.10",
    "lowlight": "^3.3.0",
    "marked": "16.4.2",
    "mermaid": "^12.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "yjs": "^13.6.33",
    "diff": "^9.0.0",
    "fflate": "0.8.3"
  }
}
